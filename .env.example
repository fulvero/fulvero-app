APP_PORT=8080
ADMINER_PORT=8082
ADMINER_BIND=127.0.0.1

POSTGRES_DB=Fulvero_ozon
POSTGRES_USER=Fulvero
POSTGRES_PASSWORD=change_this_database_password

JWT_ISSUER=Fulvero
JWT_AUDIENCE=Fulvero.Client
JWT_KEY=change_this_to_a_long_random_secret_key_at_least_32_chars

OZON_BASE_URL=https://api-seller.ozon.ru
OZON_CLIENT_ID=put_ozon_client_id_here
OZON_API_KEY=put_ozon_api_key_here

YOOKASSA_SHOP_ID=put_yookassa_shop_id_here
YOOKASSA_SECRET_KEY=put_yookassa_secret_key_here
YOOKASSA_RETURN_URL=
YOOKASSA_MONTHLY_AMOUNT=5900
YOOKASSA_CURRENCY=RUB

SMTP_ENABLED=false
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=noreply@fulvero.ru
SMTP_PASSWORD=put_smtp_password_here
SMTP_FROM_EMAIL=noreply@fulvero.ru
SMTP_FROM_NAME=Fulvero
SMTP_REPLY_TO_EMAIL=
SMTP_LOGO_FILE_PATH=wwwroot/email-logo.png
SMTP_LOGO_URL=https://fulvero.ru/assets/fulvero-logo.png

HTTPS_USE_REDIRECTION=false

BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=30
